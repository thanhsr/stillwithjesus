<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Affiliate Disclosure &middot; Still With Jesus</title>
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<meta name="robots" content="index, follow">
<meta name="facebook-domain-verification" content="4m0avj3cuefu870cm6nuydf058gfi6" />
