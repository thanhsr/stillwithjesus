  ];

  const cart = '<svg viewBox="0 0 24 24"><path d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM6.2 6l1.2 6.4c.1.6.6 1 1.2 1h7.9c.6 0 1.1-.4 1.2-1L19 8H7.4l-.3-1.5L6.7 4H3v1.5h2.5L6.2 6z"/></svg>';

  document.getElementById('grid').innerHTML = products.map(p => `
